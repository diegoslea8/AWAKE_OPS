rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && profile().role == 'admin'; }
    function roleIs(r) { return signedIn() && profile().role == r; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Provision user profiles through the Admin SDK / trusted server only.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /turns/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status == 'open' && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt','endedClientAt','status']));
      allow delete: if isAdmin();
    }
    match /tasks/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /taskCompletions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.photoURL is string;
      allow update, delete: if isAdmin();
    }
    match /purchaseRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /catalog/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /towelCounts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}